<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
    <class>MainWindow</class>
    <widget class="QMainWindow" name="MainWindow">
        <property name="geometry">
            <rect><x>0</x><y>0</y><width>1200</width><height>800</height></rect>
        </property>
        <property name="windowTitle">
            <string>Procesamiento de Imágenes Médicas</string>
        </property>
        <widget class="QWidget" name="centralwidget">
            <layout class="QVBoxLayout" name="verticalLayout">

                <!-- Botones de carga y aplicación -->
                <item>
                    <layout class="QHBoxLayout" name="buttonLayout">
                        <item><widget class="QPushButton" name="loadButton"><property name="text"><string>Cargar Imagen</string></property></widget></item>
                        <item><widget class="QPushButton" name="applyButton"><property name="text"><string>Aplicar Filtros</string></property></widget></item>
                    </layout>
                </item>

                <!-- Sliders -->
                <item>
                    <layout class="QGridLayout" name="slidersLayout">
                        <item row="0" column="0"><widget class="QLabel" name="meanLabel"><property name="text"><string>Media:</string></property></widget></item>
                        <item row="0" column="1"><widget class="QSlider" name="meanSlider"><property name="orientation"><enum>Qt::Horizontal</enum></property></widget></item>
                        <item row="0" column="2"><widget class="QLabel" name="meanValueLabel"><property name="text"><string>0</string></property></widget></item>

                        <item row="1" column="0"><widget class="QLabel" name="stdLabel"><property name="text"><string>Desviación:</string></property></widget></item>
                        <item row="1" column="1"><widget class="QSlider" name="stdSlider"><property name="orientation"><enum>Qt::Horizontal</enum></property></widget></item>
                        <item row="1" column="2"><widget class="QLabel" name="stdValueLabel"><property name="text"><string>0</string></property></widget></item>

                        <item row="2" column="0"><widget class="QLabel" name="varLabel"><property name="text"><string>Varianza:</string></property></widget></item>
                        <item row="2" column="1"><widget class="QSlider" name="varSlider"><property name="orientation"><enum>Qt::Horizontal</enum></property></widget></item>
                        <item row="2" column="2"><widget class="QLabel" name="varValueLabel"><property name="text"><string>0</string></property></widget></item>
                    </layout>
                </item>

                <!-- Procesamiento Slice -->
                <item>
                    <layout class="QHBoxLayout" name="sliceSelectionLayout">
                        <item><widget class="QLabel" name="sliceLabel"><property name="text"><string>Slice Index:</string></property></widget></item>
                        <item><widget class="QSpinBox" name="sliceSpinBox"><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="value"><number>50</number></property></widget></item>
                        <item><widget class="QPushButton" name="processButton"><property name="text"><string>Procesar Slice</string></property></widget></item>
                    </layout>
                </item>

                <!-- Imágenes principales -->
                <item>
                    <layout class="QHBoxLayout" name="imagesLayout">
                        <item><widget class="QLabel" name="originalLabel"><property name="text"><string>FLAIR</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
                        <item><widget class="QLabel" name="maskLabel"><property name="text"><string>Máscara</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
                        <item><widget class="QLabel" name="overlayLabel"><property name="text"><string>Superposición</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
                    </layout>
                </item>

                <!-- Resultados de procesamiento -->
                <item>
                    <layout class="QGridLayout" name="resultGrid">
                        <item row="0" column="0"><widget class="QLabel" name="eqHistLabel"><property name="text"><string>Equalización Hist</string></property></widget></item>
                        <item row="0" column="1"><widget class="QLabel" name="claheLabel"><property name="text"><string>CLAHE</string></property></widget></item>
                        <item row="0" column="2"><widget class="QLabel" name="gammaLabel"><property name="text"><string>Gamma</string></property></widget></item>

                        <item row="1" column="0"><widget class="QLabel" name="noisyGaussLabel"><property name="text"><string>Ruido Gauss</string></property></widget></item>
                        <item row="1" column="1"><widget class="QLabel" name="noisySpeckleLabel"><property name="text"><string>Ruido Speckle</string></property></widget></item>

                        <item row="2" column="0"><widget class="QLabel" name="blurLabel"><property name="text"><string>Desenfoque</string></property></widget></item>
                        <item row="2" column="1"><widget class="QLabel" name="gaussianLabel"><property name="text"><string>Gaussiano</string></property></widget></item>
                        <item row="2" column="2"><widget class="QLabel" name="medianLabel"><property name="text"><string>Mediana</string></property></widget></item>

                        <item row="3" column="0"><widget class="QLabel" name="cannyLabel"><property name="text"><string>Bordes Canny</string></property></widget></item>
                    </layout>
                </item>

                <!-- Resultados de slice -->
                <item>
                    <layout class="QHBoxLayout" name="sliceImagesLayout">
                        <item><widget class="QLabel" name="originalSliceLabel"><property name="text"><string>Slice Original</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
                        <item><widget class="QLabel" name="processedSliceLabel"><property name="text"><string>Slice Procesado</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
                        <item><widget class="QLabel" name="overlaySliceLabel"><property name="text"><string>Overlay Slice</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
                    </layout>
                </item>

            </layout>
        </widget>
        <widget class="QMenuBar" name="menubar"/>
        <widget class="QStatusBar" name="statusbar"/>
    </widget>
    <resources/>
    <connections/>
</ui>
